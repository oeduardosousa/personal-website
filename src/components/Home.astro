---
import Base from "../layouts/Base.astro";
import { getContent, getProjects, otherLang, paths, pub } from "../lib/content.js";

const { lang } = Astro.props;
const t = getContent(lang);
const heroNote = pub(t.hero.note);
const toolsTodo = pub(t.whatIDo.tools.todo);
const footerLine = pub(t.footer.line);
const projects = getProjects(lang);
const other = otherLang(lang);
const otherHtmlLang = other === "pt" ? "pt-BR" : "en";
const mailto = `mailto:${t.links.email}?subject=${encodeURIComponent(t.contact.emailSubject)}`;
const buildYear = new Date().getFullYear(); // no-JS fallback; site.js computes the real one
const words = t.name.split(" ");

// The best project gets twice the space. If none is flagged, the first entry leads.
const flagged = projects.findIndex((p) => p.featured);
const wideIndex = projects.length ? (flagged === -1 ? 0 : flagged) : -1;
// With the wide project first, rows are 8+4 then 4+4+4. A lone last project closes the grid wide, on the right.
const endIndex = wideIndex === 0 && projects.length > 3 && projects.length % 3 === 0 ? projects.length - 1 : -1;

const navLinks = [
  ["what-i-do", t.nav.whatIDo],
  ["work", t.nav.work],
  ["about", t.nav.about],
  ["contact", t.nav.contact],
];

// Everything the client-side dynamic layer needs, straight from content/*.json.
const dyn = {
  dynamic: t.dynamic,
  sections: navLinks.map(([id, label]) => ({ id, label })),
  sectionLabels: Object.fromEntries(navLinks.map(([id, label]) => [id, label])),
  projects: projects.map((p) => ({ id: p.id, title: p.title })),
  links: t.links,
  mailto,
};
const dynJson = JSON.stringify(dyn).replaceAll("<", String.fromCharCode(92) + "u003c"); // keep </script> out of the JSON block
---

<Base lang={lang} meta={t.meta} name={t.name}>
  <a class="skip-link" href="#main">{t.nav.skip}</a>

  <header class="site-header" data-header>
    <div class="wrap site-header__bar">
      <a class="wordmark" href={paths[lang]}>{t.name}</a>

      <nav id="site-nav" class="site-nav" aria-label={t.nav.label} data-nav>
        <ul>
          {navLinks.map(([id, label], i) => (
            <li style={`--i:${i}`}><a href={`#${id}`}>{label}</a></li>
          ))}
          <li class="nav-lang" style={`--i:${navLinks.length}`}>
            <a href={paths[other]} hreflang={otherHtmlLang} lang={otherHtmlLang} data-lang-toggle={other}>{t.nav.language.label}</a>
          </li>
        </ul>
      </nav>

      <div class="site-header__tools">
        <a class="tool tool--contact" href="#contact" data-contact-link>{t.nav.contact}</a>
        <a class="tool" href={paths[other]} hreflang={otherHtmlLang} lang={otherHtmlLang} data-lang-toggle={other} aria-label={t.nav.language.label}>
          {t.nav.language.code}
        </a>
        <button class="tool palette-btn" type="button" data-palette-open aria-label={t.dynamic.palette.open} aria-keyshortcuts="Control+K Meta+K" hidden>
          <span data-palette-key>Ctrl K</span>
        </button>
        <button class="tool tool--icon" type="button" data-theme-toggle aria-label={t.nav.theme}>
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <circle cx="12" cy="12" r="8.5"></circle>
            <path d="M12 3.5a8.5 8.5 0 0 1 0 17z" fill="currentColor"></path>
          </svg>
        </button>
        <button class="tool menu-btn" type="button" aria-expanded="false" aria-controls="site-nav" data-menu-btn>
          <span class="menu-btn__open">{t.nav.menu}</span>
          <span class="menu-btn__close">{t.nav.close}</span>
        </button>
      </div>
    </div>
    <span class="progress" aria-hidden="true" data-progress></span>
  </header>

  <main id="main">
    <section class="hero" aria-labelledby="hero-title" data-hero>
      <div class="wrap hero__grid">
        <h1 id="hero-title" aria-label={t.name} data-kinetic>
          <span aria-hidden="true">
            {words.map((word, i) => (
              <>
                <span class="word">{[...word].map((ch) => <span class="ch">{ch}</span>)}</span>{i < words.length - 1 ? " " : ""}
              </>
            ))}
          </span>
        </h1>

        <figure class="hero__photo" data-photo>
          <div class="hero__frame" data-photo-frame>
            <span class="hero__outline" aria-hidden="true"></span>
            <div class="hero__img">
              <div class="hero__float" data-photo-float>
                <img src={t.hero.photo.src} alt={t.hero.photo.alt} width="800" height="800" fetchpriority="high" decoding="async" />
              </div>
              <span class="hero__cover" aria-hidden="true"></span>
            </div>
            <figcaption class="hero__tag label">{t.hero.photo.caption}</figcaption>
          </div>
        </figure>

        <div class="hero__meta">
          <div class="hero__lead">
            <p class="hero__role">{t.hero.role}</p>
            {heroNote && <p class="hero__note">{heroNote}</p>}
            <p class="hero__cta"><a class="btn btn--primary" href={mailto}>{t.contact.buttons.email}</a></p>
          </div>
          <p class="terminal">
            <span class="terminal__prompt" aria-hidden="true">&gt;</span>
            <span class="terminal__text" data-terminal>{t.hero.terminal.fallback}</span>
            <span class="caret" aria-hidden="true"></span>
          </p>
        </div>
      </div>
    </section>

    <section id="what-i-do" class="do" aria-labelledby="what-i-do-title">
      <div class="wrap grid">
        <h2 id="what-i-do-title" class="do__title" data-split>{t.whatIDo.title}</h2>
        <div class="do__body">
          <ul class="do-list">
            {t.whatIDo.items.map((item) => (
              <li class:list={{ "do-item": item.icon }} data-reveal>
                <div>
                  <h3>{item.title}</h3>
                  <p class="measure">{item.text}</p>
                </div>
                {/* Decorative line art, same family as the typist. CSS only, transform and opacity. */}
                {item.icon === "site" && (
                  <svg class="doodle" viewBox="0 0 120 90" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" data-anim>
                    <rect x="4" y="6" width="112" height="78" rx="8" class="typist__panel"></rect>
                    <path d="M4 22h112" class="doodle__rule"></path>
                    <path d="M14 14h.01M21 14h.01M28 14h.01" class="doodle__dots"></path>
                    <rect x="14" y="31" width="26" height="3" rx="1.5" class="doodle__bar doodle__grow" style="--d:0"></rect>
                    <rect x="14" y="42" width="50" height="6" rx="2" class="doodle__bar doodle__bar--strong doodle__grow" style="--d:1"></rect>
                    <rect x="14" y="54" width="40" height="3" rx="1.5" class="doodle__bar doodle__grow" style="--d:2"></rect>
                    <rect x="78" y="31" width="28" height="42" rx="3" class="doodle__pop" style="--d:3"></rect>
                    <rect x="14" y="64" width="22" height="9" rx="2" class="doodle__accent doodle__pop" style="--d:4"></rect>
                  </svg>
                )}
                {item.icon === "app" && (
                  <svg class="doodle" viewBox="0 0 120 90" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" data-anim>
                    <rect x="4" y="6" width="112" height="78" rx="8" class="typist__panel"></rect>
                    <rect x="16" y="20" width="34" height="18" rx="9"></rect>
                    <circle cx="25" cy="29" r="5" class="doodle__knob"></circle>
                    <rect x="60" y="27.5" width="40" height="3" rx="1.5" class="doodle__bar"></rect>
                    <rect x="16" y="54" width="88" height="6" rx="3" class="doodle__track"></rect>
                    <rect x="16" y="54" width="88" height="6" rx="3" class="doodle__accent doodle__fill"></rect>
                    <path d="M0 0v15l4.2-3.8 2.8 6.6 2.8-1.2-2.8-6.4h5.6z" class="doodle__cursor"></path>
                  </svg>
                )}
              </li>
            ))}
          </ul>
          <div class="tools" data-reveal>
            <p class="label muted">{t.whatIDo.tools.label}</p>
            <ul>
              {t.whatIDo.tools.list.map((tool) => <li class="tag">{tool}</li>)}
            </ul>
            {toolsTodo && <p class="todo">{toolsTodo}</p>}
          </div>
        </div>
      </div>
    </section>

    <section id="work" class="work" aria-labelledby="work-title" data-work>
      <div class="wrap">
        <h2 id="work-title" data-split>{t.work.title}</h2>
        <p class="work__intro measure muted">{t.work.intro}</p>
        <ul class="projects">
          {projects.map((p, i) => {
            const primary = p.links.live ?? p.links.repo;
            return (
              <li class:list={["project", { "project--wide": i === wideIndex, "project--end": i === endIndex }]} id={`project-${p.id}`}>
                {p.image && (
                  <figure>
                    {primary ? (
                      <a href={primary} rel="noopener" tabindex="-1">
                        <img src={p.image.src} alt={p.image.alt} width="1440" height="900" loading="lazy" decoding="async" />
                      </a>
                    ) : (
                      <img src={p.image.src} alt={p.image.alt} width="1440" height="900" loading="lazy" decoding="async" />
                    )}
                  </figure>
                )}
                <h3>
                  {primary ? <a href={primary} rel="noopener" tabindex="-1">{p.title}</a> : p.title}
                </h3>
                <p class="measure">{p.summary}</p>
                {p.tags.length > 0 && (
                  <ul class="tags">
                    {p.tags.map((tag) => <li class="tag">{tag}</li>)}
                  </ul>
                )}
                <p class="links">
                  {p.links.repo && <a href={p.links.repo} rel="noopener">{t.work.links.repo}</a>}
                  {p.links.live && <a href={p.links.live} rel="noopener">{t.work.links.live}</a>}
                </p>
                {import.meta.env.DEV && p.todo.length > 0 && <p class="todo">[TODO] {p.todo.join(", ")}</p>}
              </li>
            );
          })}
        </ul>
      </div>
    </section>

    <section id="about" class="about" aria-labelledby="about-title">
      <div class="wrap grid">
        <div class="about__side">
          <h2 id="about-title" class="about__title" data-split>{t.about.title}</h2>
          {/* Decorative: someone typing, a small terminal filling up. CSS animation, transform and opacity only. */}
          <svg class="typist" viewBox="0 0 320 220" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" data-reveal data-anim>
            <g class="typist__term">
              <rect x="196" y="8" width="112" height="80" rx="8" class="typist__panel"></rect>
              <path d="M210 22l5 4-5 4" class="typist__prompt"></path>
              <rect x="222" y="24.5" width="52" height="3" rx="1.5" class="typist__line typist__line--1"></rect>
              <rect x="210" y="39.5" width="76" height="3" rx="1.5" class="typist__line typist__line--2"></rect>
              <rect x="210" y="54.5" width="44" height="3" rx="1.5" class="typist__line typist__line--3"></rect>
              <rect x="210" y="66" width="5" height="10" class="typist__caret"></rect>
            </g>
            {/* desk and laptop */}
            <path d="M156 150h150M292 150v64"></path>
            <path d="M200 146h52l16-46"></path>
            {/* chair */}
            <path d="M84 108l8 64h46M114 172v36M96 208h38"></path>
            {/* legs, body, head */}
            <path d="M124 164h50l5 50h18"></path>
            <path d="M112 96c-9 22-11 50-6 72h28c3-24 1-50-6-72z" class="typist__body"></path>
            <circle cx="122" cy="68" r="18" class="typist__body"></circle>
            <path d="M126 106l22 32l52 6" class="typist__arm typist__arm--back"></path>
            <path d="M122 106l22 34l58 4" class="typist__arm"></path>
          </svg>
        </div>
        <div class="about__body stack measure">
          {t.about.paragraphs.map(pub).filter(Boolean).map((text, i) => <p class:list={{ about__lead: i === 0 }} data-reveal>{text}</p>)}
          <p class="about__outside" data-reveal>
            {/* Decorative: a ball rolls in along the hairline and hops when tapped. */}
            <span class="ball" aria-hidden="true" data-anim data-ball>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10.5" class="typist__body"></circle>
                <path d="M12 8l3.8 2.76-1.45 4.48h-4.7L8.2 10.76z" fill="currentColor"></path>
                <path d="M12 8V1.5M15.8 10.76L22 8.7M14.35 15.24l3.85 5.26M9.65 15.24L5.8 20.5M8.2 10.76L2 8.7"></path>
              </svg>
            </span>
            <span class="label muted">{t.about.outside.label}</span><br />{t.about.outside.text}</p>
        </div>
      </div>
    </section>

    <section id="contact" class="contact" aria-labelledby="contact-title">
      <div class="wrap">
        {/* Decorative: a paper plane, already on its way. */}
        <span class="plane" aria-hidden="true" data-anim>
          <svg viewBox="0 0 120 80" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 72c14-2 27-9 37-20" class="plane__trail"></path>
            <g class="plane__body">
              <path d="M44 40l68-30-28 60-14-22z" class="typist__body"></path>
              <path d="M70 48l42-38M70 48l-2 16 9-8"></path>
            </g>
          </svg>
        </span>
        <h2 id="contact-title" data-split>{t.contact.title}</h2>
        <p class="buttons" data-reveal>
          <a class="btn btn--primary" href={mailto}>{t.contact.buttons.email}</a>
          <a class="btn" href={t.links.linkedin} rel="noopener">{t.contact.buttons.linkedin}</a>
          <a class="btn" href={t.links.github} rel="noopener">{t.contact.buttons.github}</a>
          <button class="btn btn--copy" type="button" data-copy={t.links.email} data-failed={t.contact.copyFailed} hidden>
            <span class="btn__label">{t.contact.buttons.copy}</span>
            <span class="btn__done" aria-hidden="true">{t.contact.copied}</span>
          </button>
        </p>
        <p class="label muted contact__email" data-reveal>{t.links.email}</p>
        <p class="sr-only" aria-live="polite" data-copy-status></p>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="wrap">
      {footerLine && <p>{footerLine}</p>}
      <ul class="footer-links label">
        <li><a href={mailto}>{t.contact.buttons.email}</a></li>
        <li><a href={t.links.linkedin} rel="noopener">{t.contact.buttons.linkedin}</a></li>
        <li><a href={t.links.github} rel="noopener">{t.contact.buttons.github}</a></li>
      </ul>
      <p class="label muted forget">
        <button class="linklike" type="button" data-forget hidden>{t.footer.forget}</button>
        <span data-forget-note hidden>{t.footer.forgetNote}</span>
      </p>
      <p class="label muted">&copy; <span data-year>{buildYear}</span> {t.footer.rights}</p>
    </div>
    {/* The name once more, typed in letter by letter on first sight, then a caret. */}
    <p class="footer-name" aria-hidden="true" data-anim>{[...t.name].map((ch, i) => (ch === " " ? " " : <span class="fch" style={`--i:${i}`}>{ch}</span>))}<span class="footer-caret" style={`--i:${t.name.length}`}></span></p>
  </footer>
  <script id="dyn" type="application/json" set:html={dynJson} />
</Base>
